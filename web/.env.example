# ArchTrace web — self-hosted / local

NEXT_PUBLIC_TEACHER_WS_URL=ws://127.0.0.1:8080

# Puerto publicado por docker compose (host → contenedor 3000)
# WEB_PORT=3000

# --- Zero-Data Retention (ZDR) ---
# Telemetría de Next.js desactivada (también forzada en la imagen).
NEXT_TELEMETRY_DISABLED=1
# Ollama en el host (desde Docker Desktop / compose con host.docker.internal).
# Deja vacío o comenta las claves cloud para modo 100 % local (sin egress a proveedores).
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# --- BYOK opcional en el servidor (solo si no usas claves en el navegador) ---
# Las claves nunca se embeben en la imagen: se inyectan en runtime vía env / .env.
# Si usas Gemini (tiene prioridad si las dos claves están definidas):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# O si usas OpenAI / otros:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=

# Raíz del proyecto que dibuja el grafo (para abrir vscode://file/... sin la extensión)
# NEXT_PUBLIC_PROJECT_ROOT=C:/ruta/al/proyecto
# NEXT_PUBLIC_EDITOR_SCHEME=cursor

# Plan Pro (sin cuentas): enlace de pago y verificación de licencias en /api/license.
# Payment Link de Stripe (o Lemon Squeezy). Su confirmación debe redirigir a https://<app>/?license={CHECKOUT_SESSION_ID}
# NEXT_PUBLIC_PRO_CHECKOUT_URL=https://buy.stripe.com/...
# Secreto HMAC de las claves ATP1.… (emitir con: PRO_LICENSE_SECRET=... npm run license:mint -- email@cliente.com [días])
# PRO_LICENSE_SECRET=
# Para aceptar el id de sesión de Checkout como licencia (solo lectura contra la API de Stripe):
# STRIPE_SECRET_KEY=sk_live_...
