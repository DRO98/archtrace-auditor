# Claves BYOK del auditor (cópialo a auditor/.env). Se usan con `--llm env` en la CLI o con la opción
# "Claves del auditor" en la UI. Nunca se guardan en el índice, la caché ni los informes.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# Modelos opcionales (si no, el del catálogo):
# GEMINI_MODEL=
# OPENAI_MODEL=
# Ollama / vLLM local:
# OLLAMA_BASE_URL=http://localhost:11434/v1

# RAG vectorial (opcional). `auto`: se usa si Qdrant y Ollama responden; `off`: solo BM25; `on`: avisa si faltan.
# ARCHTRACE_VECTOR=auto
# ARCHTRACE_QDRANT_URL=http://localhost:6333
# ARCHTRACE_OLLAMA_URL=http://localhost:11434
# ARCHTRACE_EMBED_MODEL=nomic-embed-text
