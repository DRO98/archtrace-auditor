{
  "version": "default-1",
  "categories": [
    { "id": "authentication", "prefix": "AUTH", "label": "Autenticación", "defaultCriticality": "high",
      "description": "Login, sesiones, tokens (JWT/OAuth), contraseñas, CSRF.",
      "keywords": ["autenticacion", "authentication", "login", "sesion", "session", "jwt", "token", "password", "contrasena", "csrf", "oauth"] },
    { "id": "authorization", "prefix": "AUTHZ", "label": "Autorización y permisos", "defaultCriticality": "high",
      "description": "Comprobaciones de permisos, roles, 403, decoradores y clases de permiso.",
      "keywords": ["autorizacion", "authorization", "permiso", "permission", "has_perm", "rol", "role", "403", "acceso", "access control", "forbidden"] },
    { "id": "multi_tenancy", "prefix": "TENANT", "label": "Aislamiento multi-tenant", "defaultCriticality": "high",
      "description": "Filtros por tenant/organización/cuenta; fugas de datos entre clientes.",
      "keywords": ["tenant", "multi-tenant", "multitenant", "organizacion", "organization", "organization_id", "aislamiento", "isolation"] },
    { "id": "secrets_config", "prefix": "SEC", "label": "Secretos y configuración", "defaultCriticality": "medium",
      "description": "Settings, variables de entorno, claves, DEBUG, CORS, hosts permitidos.",
      "keywords": ["secreto", "secret", "clave", "api key", "configuracion", "configuration", "settings", "env", "entorno", "cors", "debug"] },
    { "id": "privacy", "prefix": "PII", "label": "Datos personales", "defaultCriticality": "medium",
      "description": "Tratamiento de datos personales, logs con datos sensibles, RGPD.",
      "keywords": ["privacidad", "privacy", "pii", "datos personales", "personal data", "gdpr", "rgpd", "email", "log"] },
    { "id": "data_access", "prefix": "DATA", "label": "Acceso a datos", "defaultCriticality": "medium",
      "description": "SQL crudo, consultas ORM, borrados y actualizaciones masivas.",
      "keywords": ["sql", "base de datos", "database", "consulta", "query", "orm", "repositorio", "repository", "transaccion", "transaction"] },
    { "id": "migrations", "prefix": "MIGR", "label": "Migraciones de esquema", "defaultCriticality": "high",
      "description": "Migraciones, cambios de esquema, DDL.",
      "keywords": ["migracion", "migration", "esquema", "schema", "alembic", "ddl", "columna", "column"] },
    { "id": "payments", "prefix": "PAY", "label": "Pagos e importes", "defaultCriticality": "high",
      "description": "Cobros, reembolsos, importes, divisas, pasarelas (Stripe, PayPal…).",
      "keywords": ["pago", "payment", "importe", "amount", "reembolso", "refund", "stripe", "factura", "invoice", "cobro", "charge", "divisa", "currency", "centimos"] },
    { "id": "external_integrations", "prefix": "EXT", "label": "Integraciones externas", "defaultCriticality": "medium",
      "description": "Llamadas HTTP salientes, SDKs de terceros, TLS, webhooks.",
      "keywords": ["integracion", "integration", "externo", "external", "api externa", "http", "webhook", "sdk", "tercero", "third-party"] },
    { "id": "infrastructure", "prefix": "INFRA", "label": "Infraestructura y CI", "defaultCriticality": "medium",
      "description": "Dockerfile, compose, pipelines de CI/CD, despliegue.",
      "keywords": ["infraestructura", "infrastructure", "docker", "ci", "pipeline", "despliegue", "deploy", "kubernetes", "terraform"] },
    { "id": "dependencies", "prefix": "DEPS", "label": "Dependencias", "defaultCriticality": "medium",
      "description": "Manifiestos y lockfiles de dependencias.",
      "keywords": ["dependencia", "dependency", "paquete", "package", "libreria", "library", "version"] },
    { "id": "api_contract", "prefix": "API", "label": "Contrato de API", "defaultCriticality": "medium",
      "description": "Rutas, vistas, serializadores, códigos de estado y formato de respuesta.",
      "keywords": ["api", "endpoint", "ruta", "route", "contrato", "contract", "serializer", "respuesta", "response", "protocolo", "protocol", "websocket"] },
    { "id": "input_validation", "prefix": "VAL", "label": "Validación de entrada", "defaultCriticality": "medium",
      "description": "Validación, conversión y saneado de datos de entrada.",
      "keywords": ["validacion", "validation", "entrada", "input", "sanitize", "saneado", "formulario", "form"] },
    { "id": "business_logic", "prefix": "LOGIC", "label": "Lógica de negocio", "defaultCriticality": "medium",
      "description": "Cambios de comportamiento sin otra categoría más específica.",
      "keywords": ["negocio", "business", "dominio", "domain", "logica", "logic", "regla de negocio"] },
    { "id": "error_handling", "prefix": "ERR", "label": "Manejo de errores", "defaultCriticality": "low",
      "description": "try/except, excepciones, reintentos, valores por defecto ante fallo.",
      "keywords": ["error", "excepcion", "exception", "reintento", "retry", "fallo", "failure"] },
    { "id": "tests", "prefix": "TEST", "label": "Tests", "defaultCriticality": "low", "trivial": true,
      "description": "Archivos de test.",
      "keywords": ["test", "tests", "prueba", "cobertura", "coverage"] },
    { "id": "ui_style", "prefix": "UI", "label": "Estilos, assets e i18n", "defaultCriticality": "low", "trivial": true,
      "description": "CSS, imágenes y traducciones.",
      "keywords": ["css", "estilo", "style", "i18n", "traduccion", "translation", "ui"] },
    { "id": "documentation", "prefix": "DOCS", "label": "Documentación", "defaultCriticality": "low", "trivial": true,
      "description": "Documentación y comentarios; los cambios en reglas de agentes (CLAUDE.md…) no son triviales.",
      "keywords": ["documentacion", "documentation", "docs", "readme"] }
  ],
  "detectors": [
    { "id": "authz.has_perm", "category": "authorization", "target": "line", "strength": "strong", "floor": "high",
      "pattern": "\\bhas_perms?\\b|\\bhasPermission\\b|\\bcheck_?[pP]ermission\\b" },
    { "id": "authz.decorators", "category": "authorization", "target": "line", "strength": "strong", "floor": "high",
      "pattern": "@(permission_required|user_passes_test|staff_member_required|require_permission|roles_required)\\b|\\bpermission_classes\\b|\\bPermissionRequiredMixin\\b|\\bIsAdminUser\\b|\\bIsAuthenticated\\w*" },
    { "id": "authz.forbidden", "category": "authorization", "target": "line", "strength": "strong", "floor": "high",
      "pattern": "\\b(HttpResponseForbidden|PermissionDenied|HTTP_403_FORBIDDEN|ForbiddenError|Forbidden)\\b|\\bstatus(_code)?\\s*[=:(]\\s*403\\b|\\b(abort|status)\\(\\s*403\\b|\\b403\\b",
      "paths": "\\.(py|[cm]?[jt]sx?|rb|go|java|kt|php|cs)$" },
    { "id": "authz.roles", "category": "authorization", "target": "line", "strength": "strong", "floor": "high",
      "pattern": "\\b(is_superuser|is_staff|is_admin|isAdmin|hasRole|has_role|user\\.role|authorize)\\b" },
    { "id": "auth.login", "category": "authentication", "target": "line", "strength": "strong", "floor": "high",
      "pattern": "@login_required\\b|\\bLoginRequiredMixin\\b|\\b(authenticate|login|logout)\\(|\\b(check_password|make_password|set_password)\\b|\\b(bcrypt|argon2|pbkdf2)\\b" },
    { "id": "auth.tokens", "category": "authentication", "target": "line", "strength": "strong", "floor": "high",
      "pattern": "\\b(jwt|jsonwebtoken|JWT_\\w+|csrf_exempt|CSRF_\\w+|SESSION_COOKIE_\\w+|oauth2?|passport)\\b" },
    { "id": "auth.session", "category": "authentication", "target": "line", "strength": "weak", "floor": "medium",
      "pattern": "\\b(session|set_cookie|cookies?|access_token|refresh_token|password)\\b" },
    { "id": "tenant.filter", "category": "multi_tenancy", "target": "line", "strength": "strong", "floor": "high",
      "pattern": "\\b(tenant(_id)?|organization(_id)?|org_id|account_id|workspace_id|company_id)\\b" },
    { "id": "data.raw_sql", "category": "data_access", "target": "line", "strength": "strong", "floor": "high",
      "pattern": "\\b(db\\.session\\.execute|session\\.execute|cursor\\.execute|executemany|connection\\.execute|RawSQL|knex\\.raw|sequelize\\.query)\\b|\\.(raw|extra)\\(|\\$(queryRaw|executeRaw)\\w*|\\btext\\(\\s*[\"'f]" },
    { "id": "data.sql_keywords", "category": "data_access", "target": "line", "strength": "weak", "floor": "medium", "flags": "",
      "pattern": "\\b(SELECT\\s.+\\sFROM|INSERT\\s+INTO|UPDATE\\s+\\w+\\s+SET|DELETE\\s+FROM|DROP\\s+TABLE|TRUNCATE)\\b" },
    { "id": "data.bulk_write", "category": "data_access", "target": "line", "strength": "weak", "floor": "medium",
      "pattern": "\\.objects\\.(raw|extra|update|delete)\\b|\\.bulk_(create|update)\\(|\\.delete\\(\\)|\\.(deleteMany|updateMany)\\(" },
    { "id": "migrations.path", "category": "migrations", "target": "path", "strength": "strong", "floor": "high",
      "pattern": "(^|/)(migrations|alembic|migrate)/|\\.sql$|(^|/)schema\\.prisma$" },
    { "id": "migrations.ddl", "category": "migrations", "target": "line", "strength": "strong", "floor": "high",
      "pattern": "\\bmigrations\\.(AddField|RemoveField|AlterField|DeleteModel|RenameField|RunSQL|RunPython)\\b|\\bop\\.(add_column|drop_column|alter_column|drop_table|create_table)\\b|\\b(DROP\\s+(TABLE|COLUMN)|ALTER\\s+TABLE)\\b" },
    { "id": "payments.gateway", "category": "payments", "target": "line", "strength": "strong", "floor": "high",
      "pattern": "\\b(stripe|paypal|braintree|adyen|refunds?|payouts?|payment_intent|PaymentIntent|charges?\\.create)\\b" },
    { "id": "payments.amounts", "category": "payments", "target": "line", "strength": "weak", "floor": "medium",
      "pattern": "\\b(amount|price|total|currency|balance|discount|fee|subtotal|cents)\\b" },
    { "id": "payments.path", "category": "payments", "target": "path", "strength": "weak", "floor": "medium",
      "pattern": "(^|/)(payments?|billing|checkout|invoices?)(/|[._])" },
    { "id": "external.http", "category": "external_integrations", "target": "line", "strength": "strong", "floor": "medium",
      "pattern": "\\brequests\\.(get|post|put|patch|delete|request|Session)\\b|\\bhttpx\\.|\\baiohttp\\b|\\burllib\\.request\\b|\\burlopen\\(|\\baxios\\b|\\bfetch\\(|\\bboto3\\b|\\bsmtplib\\b|\\b(sendgrid|twilio|slack_sdk)\\b" },
    { "id": "external.tls_off", "category": "external_integrations", "target": "line", "strength": "strong", "floor": "high",
      "pattern": "\\bverify\\s*=\\s*False\\b|rejectUnauthorized\\s*:\\s*false|NODE_TLS_REJECT_UNAUTHORIZED" },
    { "id": "config.path", "category": "secrets_config", "target": "path", "strength": "strong", "floor": "medium",
      "pattern": "(^|/)settings[^/]*\\.py$|(^|/)\\.env(\\.[\\w.-]+)?$|(^|/)config/|\\.(ini|cfg)$|(^|/)application\\.(ya?ml|properties)$|(^|/)next\\.config\\.\\w+$" },
    { "id": "config.secrets", "category": "secrets_config", "target": "line", "strength": "strong", "floor": "high",
      "pattern": "\\b(SECRET_KEY|PRIVATE_KEY|API_KEY|ACCESS_KEY|AWS_SECRET\\w*|DEBUG\\s*=\\s*True|ALLOWED_HOSTS|CORS_ALLOW\\w*|CORS_ORIGIN\\w*)\\b|(password|secret|token|api_?key)\\s*[:=]\\s*[\"'][^\"']{6,}[\"']" },
    { "id": "config.env", "category": "secrets_config", "target": "line", "strength": "weak", "floor": "medium",
      "pattern": "\\bos\\.environ\\b|\\bgetenv\\(|\\bprocess\\.env\\b" },
    { "id": "privacy.pii", "category": "privacy", "target": "line", "strength": "weak", "floor": "medium",
      "pattern": "\\b(email|phone|ssn|dni|nif|date_of_birth|birth_date|address|personal_data|gdpr)\\b" },
    { "id": "privacy.log_secret", "category": "privacy", "target": "line", "strength": "strong", "floor": "high",
      "pattern": "\\b(log(ger)?\\.\\w+|print|console\\.log)\\(.*\\b(password|token|secret|card_number|cvv)\\b" },
    { "id": "infra.path", "category": "infrastructure", "target": "path", "strength": "strong", "floor": "medium",
      "pattern": "(^|/)Dockerfile[^/]*$|(^|/)docker-compose[^/]*\\.ya?ml$|(^|/)\\.github/workflows/|(^|/)\\.gitlab-ci\\.yml$|(^|/)Jenkinsfile$|(^|/)(k8s|helm|terraform)/|\\.tf$|(^|/)Procfile$" },
    { "id": "deps.manifest", "category": "dependencies", "target": "path", "strength": "strong", "floor": "medium",
      "pattern": "(^|/)(package\\.json|package-lock\\.json|pnpm-lock\\.yaml|yarn\\.lock|requirements[^/]*\\.txt|Pipfile(\\.lock)?|pyproject\\.toml|poetry\\.lock|go\\.(mod|sum)|Cargo\\.(toml|lock)|Gemfile(\\.lock)?)$" },
    { "id": "api.routes", "category": "api_contract", "target": "line", "strength": "weak", "floor": "medium",
      "pattern": "\\burlpatterns\\b|\\b(re_)?path\\(|@(app|router|bp|blueprint)\\.(get|post|put|patch|delete|route)\\b|\\brouter\\.(get|post|put|patch|delete)\\(|\\b(APIView|ViewSet|ModelViewSet)\\b|@api_view\\b|\\bSerializer\\b|\\b(JsonResponse|HttpResponse)\\b|\\bstatus_code\\b" },
    { "id": "validation.input", "category": "input_validation", "target": "line", "strength": "weak", "floor": "low",
      "pattern": "\\b(validate\\w*|validator|clean_\\w+|is_valid|sanitize\\w*|escape|bleach|zod|yup|joi|pydantic)\\b|\\b(int|float|Decimal|parseInt|parseFloat|Number)\\(" },
    { "id": "errors.handling", "category": "error_handling", "target": "line", "strength": "weak", "floor": "low",
      "pattern": "\\bexcept\\b|\\btry\\s*[:{]|\\bcatch\\s*\\(|\\.catch\\(|\\braise\\b|\\bthrow\\b|\\bfinally\\b" },
    { "id": "tests.path", "category": "tests", "target": "path", "strength": "weak", "floor": "low",
      "pattern": "(^|/)(tests?|__tests__|spec)/|(^|/)test_[^/]+\\.py$|_test\\.(py|go)$|\\.(test|spec)\\.[cm]?[jt]sx?$" },
    { "id": "ui.path", "category": "ui_style", "target": "path", "strength": "weak", "floor": "low",
      "pattern": "\\.(css|scss|sass|less|styl|svg|png|jpe?g|gif|ico|webp|woff2?)$|(^|/)(locales?|i18n|translations|lang)/|\\.(po|mo)$" },
    { "id": "docs.path", "category": "documentation", "target": "path", "strength": "weak", "floor": "low",
      "pattern": "\\.(md|mdx|rst|adoc|txt)$|(^|/)docs/" },
    { "id": "docs.agent_rules", "category": "documentation", "target": "path", "strength": "strong", "floor": "medium",
      "pattern": "(^|/)(CLAUDE|AGENTS)\\.md$|(^|/)\\.cursorrules$|(^|/)\\.cursor/rules/|(^|/)\\.claude/" }
  ]
}
