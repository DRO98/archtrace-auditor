{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@core/*": ["../core/src/*"],
      "@scanner/*": ["../scanner/src/*"],
      "@llm/*": ["../llm/src/*"]
    }
  },
  "include": ["src", "../core/src"]
}
