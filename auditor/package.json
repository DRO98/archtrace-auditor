{
  "name": "archtrace-auditor",
  "version": "0.1.0",
  "private": true,
  "description": "Auditor independiente de cambios hechos por agentes IA: CLI `archtrace-audit` + servidor HTTP local (127.0.0.1:8090).",
  "bin": {
    "archtrace-audit": "bin/archtrace-audit.cjs"
  },
  "scripts": {
    "audit": "tsx src/cli/main.ts",
    "serve": "tsx src/cli/main.ts serve",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
